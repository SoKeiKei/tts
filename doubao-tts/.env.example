# 示例，不要写入真实密钥，也不要提交 .env
DOUBAO_TTS_API_KEY=your_key_here
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
# 可选。默认固定官方地址。只有受控网络才需要改。
# DOUBAO_TTS_BASE_URL=https://openspeech.bytedance.com
# 测试专用：允许把 BASE_URL 指到本机 mock。不要在生产打开。
# DOUBAO_TTS_ALLOW_TEST_BASE=1
# 可选：覆盖音色预设目录，默认 %APPDATA%/doubao-tts
# DOUBAO_TTS_CONFIG_DIR=

# 示例，不要写入真实密钥，也不要提交 .env
MINIMAX_TTS_API_KEY=your_key_here
# 国内默认。国际账号请改成 https://api.minimax.io ，不要依赖自动切换。
MINIMAX_TTS_API_BASE=https://api.minimaxi.com
MINIMAX_TTS_DEFAULT_MODEL=speech-2.8-hd
# 测试专用：允许把 API_BASE 指到本机 mock。不要在生产打开。
# MINIMAX_TTS_ALLOW_TEST_BASE=1
# 可选：覆盖音色预设目录，默认 %APPDATA%/minimax-tts
# MINIMAX_TTS_CONFIG_DIR=
